# Copy this file to .env and fill in your values

# Ganache RPC URL (match your Ganache port)
GANACHE_URL=http://127.0.0.1:8545

# Deployed contract address (checksum recommended)
CONTRACT_ADDRESS=0x...

# Optional override for the sending account
CONTRACT_OWNER=0x...

# Total on-chain records to write in the notebook (2 records per CSV row)
TARGET_CONTRACT_RECORDS=100

# Notebook runtime settings
CSV_PATH=IOT Data Simulation/smart_logistic_tracker_japan.csv
ABI_PATH=contracts/abi.json
SAMPLE_ROWS=5
WRITE_DELAY_SECONDS=0.1
WRITE_GAS_LIMIT=3000000
ENABLE_DUPLICATE_WRITES=false

# Copy this file to .env and fill in your values.
# The Milestone 1 notebook loads all values below via python-dotenv (load_dotenv()).

# Ganache RPC URL (match your Ganache port — usually 7545 for Ganache GUI, 8545 for CLI)
GANACHE_URL=http://127.0.0.1:7545

# Deployed contract address — copy from Remix after deploying IoTDataStorage.sol
# (must be deployed via Web3 Provider connected to Ganache, not JavaScript VM)
CONTRACT_ADDRESS=0x...

# Path to the source IoT CSV
CSV_PATH=IOT Data Simulation/smart_logistics_tracker_japan_kaizenlogistics.csv

# Path to the compiled contract ABI
ABI_PATH=contracts/abi.json

# Transaction settings
WRITE_DELAY_SECONDS=0.1
WRITE_GAS_LIMIT=3000000

d'\\] = working\\.loc\\[mask, 'numeric_value_filled'\\]\\.fillna\\(group_median\\)\noverall_median = working\\['numeric_value'\\]\\.median\\(\\)\nif pd\\.notna\\(overall_median\\):\n    working\\['numeric_value_filled'\\] = working\\['numeric_value_filled'\\]\\.fillna\\(overall_median\\)\n\nduplicate_mask = working\\.duplicated\\(subset=\\['timestamp', 'device_id', 'data_type', 'data_value_raw'\\], keep='first'\\)\nworking\\['is_duplicate'\\] = duplicate_mask\n\ndef is_inconsistent\\(row\\):\n    expected = expected_units\\.get\\(row\\['data_type'\\]\\)\n    if not expected or pd\\.isna\\(row\\['unit_text'\\]\\):\n        return False\n    unit_text = str\\(row\\['unit_text'\\]\\)\\.strip\\(\\)\\.lower\\(\\)\n    return unit_text not in \\{unit\\.lower\\(\\) for unit in expected\\}\n\nworking\\['is_inconsistent'\\] = working\\.apply\\(is_inconsistent, axis=1\\)\nworking\\['is_outlier'\\] = False\nfor data_type, group in working\\.groupby\\('data_type'\\):\n    valid = group\\['numeric_value'\\]\\.dropna\\(\\)\n    if len\\(valid\\) < 4:\n        continue\n    q1 = valid\\.quantile\\(0\\.25\\)\n    q3 = valid\\.quantile\\(0\\.75\\)\n    iqr = q3 - q1\n    lower_bound = q1 - 1\\.5 \\* iqr\n    upper_bound = q3 \\+ 1\\.5 \\* iqr\n    outlier_index = group\\.index\\[\\(group\\['numeric_value'\\] < lower_bound\\) \\| \\(group\\['numeric_value'\\] > upper_bound\\)\\]\n    working\\.loc\\[outlier_index, 'is_outlier'\\] = True\n\ncleaned_df = working\\.loc\\[~working\\['is_duplicate'\\]\\]\\.copy\\(\\)\nhourly_summary = \\(\n    cleaned_df\\.groupby\\(\\['hour', 'data_type'\\], dropna=False\\)\n    \\.agg\\(\n        reading_count=\\('numeric_value_filled', 'count'\\),\n        average_value=\\('numeric_value_filled', 'mean'\\),\n        median_value=\\('numeric_value_filled', 'median'\\),\n        minimum_value=\\('numeric_value_filled', 'min'\\),\n        maximum_value=\\('numeric_value_filled', 'max'\\),\n        missing_value_count=\\('data_value_raw', lambda series: se